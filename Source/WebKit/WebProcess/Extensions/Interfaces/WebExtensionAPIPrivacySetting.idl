[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted,
    UseCPPAPI
] interface WebExtensionAPIPrivacySetting {
    [RaisesStringException] void get([JSONValue] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void set([JSONValue] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void clear([JSONValue] any details, [Optional, CallbackHandler] function callback);
    readonly attribute WebExtensionAPIEvent onChange;
};
