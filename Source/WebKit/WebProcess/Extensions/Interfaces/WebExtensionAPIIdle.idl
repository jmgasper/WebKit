[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted,
    UseCPPAPI
] interface WebExtensionAPIIdle {
    [RaisesStringException] void queryState(double detectionIntervalInSeconds, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void setDetectionInterval(double intervalInSeconds);
    readonly attribute WebExtensionAPIEvent onStateChanged;
};
