dictionary WebExtensionActionDetails {
    double tabId;
    double windowId;
};

dictionary WebExtensionActionSetTitleDetails {
    DOMString title;
    double tabId;
    double windowId;
};

dictionary WebExtensionActionSetPopupDetails {
    DOMString popup;
    double tabId;
    double windowId;
};

dictionary WebExtensionActionSetBadgeTextDetails {
    DOMString text;
    double tabId;
    double windowId;
};

dictionary WebExtensionActionSetBadgeBackgroundColorDetails {
    any color;
    double tabId;
    double windowId;
};

dictionary WebExtensionActionSetIconDetails {
    any imageData;
    any path;
    double tabId;
    double windowId;
};

dictionary WebExtensionActionOpenPopupOptions {
    double windowId;
};

[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    UseCPPAPI,
    ReturnsPromiseWhenCallbackIsOmitted,
] interface WebExtensionAPIAction {

    [RaisesStringException] void getTitle([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void setTitle([JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void getBadgeText([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void setBadgeText([JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void getBadgeBackgroundColor([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void setBadgeBackgroundColor([JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [Platform=HAIKU, RaisesStringException] void getBadgeTextColor([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [Platform=HAIKU, RaisesStringException] void setBadgeTextColor([JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    // Chrome's { isOnToolbar }; Summit shows every action in its toolbar.
    [Platform=HAIKU] void getUserSettings([Optional, CallbackHandler] function callback);

    [RaisesStringException, NeedsScriptContext] void enable([Optional, ValuesAllowed] any tabId, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsScriptContext] void disable([Optional, ValuesAllowed] any tabId, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void isEnabled([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);

    [RaisesStringException, NeedsFrame, NeedsScriptContext] void setIcon([ValuesAllowed] any details, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void setPopup([JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void getPopup([Optional, JSONValue=NullAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsPageIdentifier] void openPopup([Optional, JSONValue=NullAllowed] any options, [Optional, CallbackHandler] function callback);

    readonly attribute WebExtensionAPIEvent onClicked;

};
