enum WebExtensionTabStatus {
    "loading",
    "complete"
};

dictionary WebExtensionTabMutedInfo {
    boolean muted;
};

dictionary WebExtensionTab {
    double id;
    double index;
    double windowId;
    double openerTabId;
    boolean selected;
    boolean highlighted;
    boolean active;
    boolean pinned;
    boolean audible;
    boolean incognito;
    boolean isArticle;
    boolean isInReaderMode;
    WebExtensionTabMutedInfo mutedInfo;
    DOMString url;
    DOMString title;
    WebExtensionTabStatus status;
    double width;
    double height;
};

dictionary WebExtensionTabCreateProperties {
    double windowId;
    double index;
    DOMString url;
    DOMString title;
    boolean active;
    boolean selected;
    boolean highlighted;
    boolean pinned;
    boolean muted;
    double openerTabId;
    boolean openInReaderMode;
};

[
    Conditional=WK_WEB_EXTENSIONS,
    UseCPPAPI,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted,
] interface WebExtensionAPITabs {

    [RaisesStringException, NeedsPageIdentifier, ImplementedAs=createTab] void create([JSONValue] any properties, [Optional, CallbackHandler] function callback);

    [RaisesStringException, NeedsPageIdentifier] void query([JSONValue] any info, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void get(double tabID, [Optional, CallbackHandler] function callback);
    [NeedsPageIdentifier] void getCurrent([Optional, CallbackHandler] function callback);
    [Platform=COCOA, RaisesStringException, Dynamic, NeedsPageIdentifier] void getSelected([Optional] double windowID, [Optional, CallbackHandler] function callback);

    [Platform=COCOA, RaisesStringException] void duplicate(double tabID, [Optional, JSONValue] any properties, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsPageIdentifier] void update([Optional] double tabID, [JSONValue] any properties, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsScriptContext] void move([ValuesAllowed] any tabIDs, [JSONValue] any properties, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsScriptContext] void remove([ValuesAllowed] any tabIDs, [Optional, CallbackHandler] function callback);

    [RaisesStringException, NeedsPageIdentifier] void reload([Optional] double tabID, [Optional, JSONValue] any properties, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsPageIdentifier] void goBack([Optional] double tabID, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsPageIdentifier] void goForward([Optional] double tabID, [Optional, CallbackHandler] function callback);

    [Platform=COCOA, RaisesStringException, NeedsPageIdentifier] void getZoom([Optional] double tabID, [Optional, CallbackHandler] function callback);
    [Platform=COCOA, RaisesStringException, NeedsPageIdentifier] void setZoom([Optional] double tabID, double zoomFactor, [Optional, CallbackHandler] function callback);

    [Platform=COCOA, RaisesStringException, NeedsPageIdentifier] void detectLanguage([Optional] double tabID, [Optional, CallbackHandler] function callback);

    [Platform=COCOA, RaisesStringException, NeedsPageIdentifier] void toggleReaderMode([Optional] double tabID, [Optional, CallbackHandler] function callback);

    [RaisesStringException, NeedsPageIdentifier] void captureVisibleTab([Optional] double windowID, [Optional, JSONValue] any options, [Optional, CallbackHandler] function callback);

    [RaisesStringException, Dynamic, NeedsPageIdentifier] void executeScript([Optional, Finite] double tabID, [JSONValue] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException, Dynamic, NeedsPageIdentifier] void insertCSS([Optional] double tabID, [JSONValue] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException, Dynamic, NeedsPageIdentifier] void removeCSS([Optional] double tabID, [JSONValue] any details, [Optional, CallbackHandler] function callback);

    [ProcessArgumentsLeftToRight, RaisesStringException, NeedsFrame] void sendMessage(double tabID, [Serialization=JSON, ValuesAllowed] any message, [Optional, JSONValue] any options, [Optional, CallbackHandler] function callback);
    [RaisesStringException, NeedsFrame, NeedsScriptContext] WebExtensionAPIPort connect(double tabID, [Optional, JSONValue] any options);

    [ImplementedAs=tabIdentifierNone] readonly attribute double TAB_ID_NONE;

    readonly attribute WebExtensionAPIEvent onActivated;
    readonly attribute WebExtensionAPIEvent onAttached;
    readonly attribute WebExtensionAPIEvent onCreated;
    readonly attribute WebExtensionAPIEvent onDetached;
    readonly attribute WebExtensionAPIEvent onHighlighted;
    readonly attribute WebExtensionAPIEvent onMoved;
    readonly attribute WebExtensionAPIEvent onRemoved;
    readonly attribute WebExtensionAPIEvent onReplaced;
    readonly attribute WebExtensionAPIEvent onUpdated;

};
