enum WebExtensionScriptInjectionExecutionWorld {
    "ISOLATED",
    "MAIN"
};

enum WebExtensionCSSOrigin {
    "USER",
    "AUTHOR"
};

dictionary WebExtensionScriptInjectionTarget {
    boolean allFrames;
    sequence<DOMString> documentIds;
    sequence<double> frameIds;
    required double tabId;
};

dictionary WebExtensionScriptInjection {
    sequence<any> args;
    sequence<DOMString> files;
    any func;
    required WebExtensionScriptInjectionTarget target;
    DOMString world;
};

dictionary WebExtensionCSSInjection {
    DOMString css;
    sequence<DOMString> files;
    DOMString origin;
    required WebExtensionScriptInjectionTarget target;
};

[
    Conditional=WK_WEB_EXTENSIONS,
    MainWorldOnly,
    ReturnsPromiseWhenCallbackIsOmitted,
    UseCPPAPI,
] interface WebExtensionAPIScripting {

    // 'func' is a function, which no JSON conversion preserves, so the details value reaches the implementation unconverted.
    [RaisesStringException, NeedsScriptContext] void executeScript([ValuesAllowed] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void insertCSS([JSONValue] any details, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void removeCSS([JSONValue] any details, [Optional, CallbackHandler] function callback);

    [RaisesStringException] void registerContentScripts([JSONValue=Array] any scripts, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void getRegisteredContentScripts([Optional, JSONValue] any filter, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void unregisterContentScripts([Optional, JSONValue] any filter, [Optional, CallbackHandler] function callback);
    [RaisesStringException] void updateContentScripts([JSONValue=Array] any scripts, [Optional, CallbackHandler] function callback);

    [ImplementedAs=executionWorlds] readonly attribute any ExecutionWorld;
};
